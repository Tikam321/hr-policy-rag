# =============================================================================
# HR Policy RAG — Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# =============================================================================

# --- App ---
ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=dev-api-key-change-in-production

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# --- PostgreSQL ---
DATABASE_URL=postgresql://hr_rag:hr_rag@localhost:5432/hr_rag

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=hr_policies

# --- Redis (Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- RAG Config ---
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_PERCENT=15
RETRIEVAL_TOP_K=30
RERANK_TOP_K=6
MAX_CONTEXT_TOKENS=4000

# --- Data Generation ---
# LLM provider for synthetic policy text: "openai" (default) or "mistral"
DATA_GENERATION_LLM_PROVIDER=openai
DATA_GENERATION_LLM_MODEL=gpt-4o-mini
# Mistral (OpenAI-compatible endpoint) — set when DATA_GENERATION_LLM_PROVIDER=mistral
MISTRAL_API_KEY=your-mistral-key-here
# Client retry/timeout (handles rate limits)
DATA_GENERATION_LLM_MAX_RETRIES=8
DATA_GENERATION_LLM_TIMEOUT=60
DEFAULT_CORPUS_COMPANIES=5
DEFAULT_CORPUS_POLICIES=10
